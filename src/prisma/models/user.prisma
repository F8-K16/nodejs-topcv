model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique @db.VarChar(100)
  username        String           @db.VarChar(30)
  password        String           @db.VarChar(100)
  avatar          String?
  createdAt       DateTime         @default(now()) @db.Timestamp(0)
  updatedAt       DateTime         @updatedAt @db.Timestamp(0)
  deletedAt       DateTime?        @db.Timestamp(0)
  isVerified      Boolean          @default(false)
  isBlocked       Boolean          @default(false)
  receiveEmailNotifications Boolean   @default(true)
  candidate       Candidate?
  employer        Employer?
  userPhone       UserPhone?
  userPermissions UserPermission[]
  userRoles       UserRole[]
  notifications   Notification[]
  cvs             Cv[]
  auditLogs       AuditLog[]

  chatEmployerConversations  ChatConversation[] @relation("ChatEmployerSide")
  chatCandidateConversations ChatConversation[] @relation("ChatCandidateSide")
  chatMessagesSent           ChatMessage[]      @relation("ChatMessageSender")

  @@index([createdAt], map: "users_createdAt_idx")
  @@index([deletedAt], map: "users_deletedAt_idx")
  @@map("users")
}
