model ChatConversation {
  id                         Int           @id @default(autoincrement())
  employerUserId             Int
  candidateUserId            Int
  lastMessageAt              DateTime?     @db.Timestamp(0)
  createdAt                  DateTime      @default(now()) @db.Timestamp(0)
  updatedAt                  DateTime      @updatedAt @db.Timestamp(0)
  candidateLastReadMessageId Int?
  employerLastReadMessageId  Int?
  candidateUser              User          @relation("ChatCandidateSide", fields: [candidateUserId], references: [id], onDelete: Cascade)
  employerUser               User          @relation("ChatEmployerSide", fields: [employerUserId], references: [id], onDelete: Cascade)
  messages                   ChatMessage[]

  @@unique([employerUserId, candidateUserId], map: "chat_conversations_employer_candidate_key")
  @@index([employerUserId])
  @@index([candidateUserId])
  @@index([lastMessageAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  senderUserId   Int
  body           String           @db.Text
  createdAt      DateTime         @default(now()) @db.Timestamp(0)
  imageUrl       String?          @db.Text
  kind           ChatMessageKind  @default(TEXT)
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "chat_messages_conversation_created_idx")
  @@index([senderUserId], map: "chat_messages_senderUserId_fkey")
  @@map("chat_messages")
}

enum ChatMessageKind {
  TEXT
  IMAGE
}
