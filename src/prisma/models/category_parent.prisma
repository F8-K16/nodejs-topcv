model CategoryParent {
  id         Int             @id @default(autoincrement())
  name       String
  slug       String          @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?       @db.Timestamp(0)
  categories Category[]
  companies  CompanyCategory[]

  @@index([deletedAt])
  @@map("category_parents")
}
