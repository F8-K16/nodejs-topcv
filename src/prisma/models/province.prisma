model Province {
  id                                      Int                   @id @default(autoincrement())
  name                                    String
  code                                    String?               @unique
  createdAt                               DateTime              @default(now()) @db.Timestamp(0)
  updatedAt                               DateTime              @updatedAt @db.Timestamp(0)
  deletedAt                               DateTime?             @db.Timestamp(0)
  candidatePreferencesAsPreferredProvince CandidatePreference[] @relation("CandidatePrefProvince")
  candidates                              Candidate[]
  companies                               Company[]
  districts                               District[]

  @@index([deletedAt])
  @@map("provinces")
}
