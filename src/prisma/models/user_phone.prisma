model UserPhone {
  id        Int      @id @default(autoincrement())
  phone     String   @unique @db.VarChar(15)
  userId    Int      @unique
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)
  user      User     @relation(fields: [userId], references: [id])

  @@map("user_phone")
}
